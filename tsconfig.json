{
  "compilerOptions": {
    "target": "es2022",
    "rootDir": ".",
    "outDir": "bin",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "sourceMap": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "tests/*.ts"
  ]
}